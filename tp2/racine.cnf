# Configuration de l'AC racine (utilisee pour signer l'intermediaire et la CRL racine)
[ca]
default_ca = CA_racine

[CA_racine]
dir               = ./racine
database          = $dir/index.txt
serial            = $dir/serial
crlnumber         = $dir/crlnumber
new_certs_dir     = $dir/newcerts
certificate       = $dir/racine.crt
private_key       = $dir/racine.key
default_md        = sha384
policy            = policy_ac
unique_subject    = no
default_crl_days  = 30
copy_extensions   = none

[policy_ac]
countryName       = optional
organizationName  = optional
commonName        = supplied

# Extensions appliquees au certificat de l'AC intermediaire
[ext_inter]
basicConstraints        = critical,CA:TRUE,pathlen:0
keyUsage                = critical,keyCertSign,cRLSign
subjectKeyIdentifier    = hash
authorityKeyIdentifier  = keyid:always
nameConstraints         = critical,permitted;DNS:tp.local,permitted;email:tp.local
